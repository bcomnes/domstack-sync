<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} - domstack-sync</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  {{> nav}}
  <main
    id="main"
    class="main"
    hx-get="{{path}}"
    hx-trigger="bs:state-update from:body"
    hx-select=".page"
    hx-swap="innerHTML"
  >
    {{{body}}}
  </main>
  <script type="module" src="/app.js"></script>
</body>
</html>
