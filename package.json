{
  "name": "@domstack/sync",
  "description": "A modern, minimal live-reload dev server",
  "version": "0.0.5",
  "author": "Bret Comnes <bcomnes@gmail.com> (https://bret.io)",
  "bugs": {
    "url": "https://github.com/bcomnes/domstack-sync/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "bin": {
    "domstack-sync": "./lib/cli.js",
    "dss": "./lib/cli.js"
  },
  "files": [
    "index.d.ts",
    "index.d.ts.map",
    "index.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/*.js",
    "lib/client/dist/**/*.js",
    "lib/ui/public/**/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bcomnes/domstack-sync.git"
  },
  "homepage": "https://github.com/bcomnes/domstack-sync",
  "keywords": [
    "live-reload",
    "dev-server",
    "domstack-sync",
    "browser-sync"
  ],
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^10.1.0",
    "argsclopts": "^1.0.5",
    "chokidar": "^5.0.0",
    "fastify": "^5.0.0",
    "fastify-fragtml": "^0.0.3",
    "fragtml": "^0.0.9",
    "htmx.org": "^4.0.0-beta4",
    "pesticide": "1.3.1",
    "picomatch": "^4.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.0.1",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.0.0",
    "@voxpelli/tsconfig": "^16.1.0",
    "esbuild": "^0.28.1",
    "json-schema-to-ts": "^3.1.1",
    "neostandard": "^0.13.0",
    "npm-run-all2": "^9.0.0",
    "releasearoni": "^0.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepublishOnly": "releasearoni",
    "prepare": "run-s build:assets",
    "prepack": "run-s clean build:declaration",
    "postpublish": "npm run clean",
    "test": "run-s test:*",
    "test:lint": "eslint .",
    "test:tsc": "tsc",
    "test:node-test": "node --experimental-test-coverage --test-reporter=dot --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info --test-timeout=10000 --test",
    "test:playwright": "run-s build:assets test:playwright:*",
    "test:playwright:run": "playwright test --timeout=10000",
    "version": "releasearoni version",
    "build": "run-s clean build:assets build:declaration",
    "build:assets": "run-p build:assets:*",
    "build:assets:client": "esbuild lib/client/index.ts --bundle --platform=browser --target=es2020 --format=iife --global-name=BrowserSyncClient --minify --outfile=lib/client/dist/browser-sync-client.js",
    "build:assets:ui-js": "esbuild lib/ui/client.ts --bundle --platform=browser --target=es2020 --format=esm --minify --outfile=lib/ui/public/app.js",
    "build:assets:ui-css": "esbuild lib/ui/app/styles/index.css --bundle --minify --outfile=lib/ui/public/app.css",
    "build:declaration": "tsc -p declaration.tsconfig.json",
    "clean": "run-p clean:*",
    "clean:declarations-top": "rm -rf $(find . -maxdepth 1 -type f -name '*.d.ts*')",
    "clean:js-top": "rm -rf $(find . -maxdepth 1 -type f -name '*.js' ! -name '*.config.js')",
    "clean:declarations-lib": "rm -rf $(find lib -type f -name '*.d.ts*' ! -path 'lib/ui/htmx-types.d.ts')",
    "clean:js-lib": "rm -rf $(find lib -type f -name '*.js' ! -path 'lib/client/dist/*' ! -path 'lib/ui/public/*')"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bcomnes"
  }
}
