{
  "extends": "@voxpelli/tsconfig/node22.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "**/*.js",
    "node_modules",
    "coverage",
    ".github",
    ".legacy",
    "lib/client",
    "lib/ui/app",
    "dist"
  ]
}
